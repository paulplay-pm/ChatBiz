# PostgreSQL (asyncpg) used by SQLAlchemy for workflow state
DATABASE_URL=postgresql+asyncpg://chatbiz:chatbiz@postgres:5432/workflow_engine
# Redis for canvas real-time state + event sourcing
REDIS_URL=redis://redis:6379/0
# Data isolation gateway base URL (mandatory egress point)
AUDIT_ISOLATION_URL=http://audit-and-isolation:8080
# Credential service (for plugin / LLM provider secret resolution)
CREDENTIAL_SERVICE_URL=http://credential:8000
# Knowledge base service
KNOWLEDGE_BASE_URL=http://knowledge-base:8002
# Agent runtime service (Lead / Sub-Agent execution)
AGENT_RUNTIME_URL=http://agent-runtime:8003
# Service-to-service auth token presented by this engine
WORKFLOW_ENGINE_SERVICE_TOKEN=dev-wf-token
# WeCom webhook for human-approval notifications (leave empty to disable)
WECOM_WEBHOOK_URL=
LOG_LEVEL=info
ENVIRONMENT=local
# Enable Docker-based plugin sandbox (set to false to fall back to in-process execution)
DOCKER_SANDBOX_ENABLED=true
DOCKER_SOCKET=/var/run/docker.sock
