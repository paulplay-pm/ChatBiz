# V6a V0 企微扫码环境变量(.env.local 入库;.env.example 入库)
# 真企微 sandbox corpId 从 https://work.weixin.qq.com/wework_admin/ 获取

# 企微 corpId(必填)
WECHAT_CORP_ID=
# 企微 AgentId(必填)
WECHAT_AGENT_ID=
# 企微 CorpSecret(必填)
WECHAT_SECRET=
# 企微 OAuth2 redirect_uri(默认 nginx 5173)
# V6a dev 走 chatbiz-sso-mock;prod 走真企微 HTTPS
WECHAT_REDIRECT_URI=http://localhost:5173/portal/sso-callback

# JWT RS256 RSA 2048(可选,首次启动自动 generate + 持久化到 secrets/jwt_private.pem)
# JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem
# JWT_ISSUER=https://sso.chatbiz.local
# JWT_AUDIENCE=chatbiz-web
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Postgres(复用 chatbiz-postgres)
# POSTGRES_DSN=postgresql+asyncpg://chatbiz:chatbiz@chatbiz-postgres:5432/chatbiz

# Redis(存 CSRF state,TTL 5min)
# REDIS_URL=redis://chatbiz-redis:6379/0
