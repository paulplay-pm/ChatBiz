# Build artifacts (regenerated by pnpm build inside the container)
**/node_modules
**/dist
**/.vite
**/coverage

# VCS + git metadata
.git
.gitignore
.gitattributes

# Secrets and env files (NEVER bake into an image)
**/.env
**/.env.*
!**/.env.example

# OS / editor cruft
.DS_Store
Thumbs.db
**/.idea
**/.vscode
**/.eslintcache
**/.prettiercache
**/*.swp
**/*.swo

# This file itself (avoid recursive ignore confusion)
.dockerignore
Dockerfile
